{
  "name": "fitcrew",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.16.0",
  "scripts": {
    "postinstall": "pnpm --filter @fitcrew/db generate",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "boundaries": "depcruise packages apps --config .dependency-cruiser.cjs",
    "migrate:check": "pnpm --filter @fitcrew/db run migrate:check",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "ci": "pnpm db:up && pnpm build && pnpm lint && pnpm boundaries && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.4.2",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
