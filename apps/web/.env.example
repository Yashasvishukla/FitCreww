# The application must use the restricted app role, never the migration role.
DATABASE_URL="postgresql://fitcrew_app:fitcrew_app@127.0.0.1:55432/fitcrew"

# Generate a unique value per environment: `openssl rand -base64 32`.
AUTH_SECRET="replace-with-a-long-random-secret"

# Public origin used to build secure coach and organization invite links.
APP_BASE_URL="http://localhost:3000"

# USDA FoodData Central API key used for nutrition lookup.
# Leave blank in local/offline development to use FitCrew's built-in fallback catalog.
USDA_FDC_API_KEY=""

# Set to `mock` only for local UI development. Omit in staging/production to
# use Razorpay; rzp_test_* keys are valid for a production-like staging build.
# PAYMENT_GATEWAY_MODE="mock"
# RAZORPAY_KEY_ID="rzp_test_replace_with_your_key_id"
# RAZORPAY_KEY_SECRET="replace-with-server-only-secret"
# RAZORPAY_WEBHOOK_SECRET="replace-with-a-unique-webhook-secret"
# Temporary overlap only while rotating a webhook secret; remove after the
# Razorpay retry window. Never reuse test/staging/live webhook secrets.
# RAZORPAY_WEBHOOK_PREVIOUS_SECRET=""

# Exceptional local-only migration aid for legacy manual client collections.
# Do not set this in Test, Staging, or Production; new client collections use
# Razorpay Checkout by default and this value is ignored in production.
# PAYMENT_COLLECTION_MODE="manual"

# Transactional email (Resend). Required outside development.
# Verify your sending domain in Resend before using an address on it.
RESEND_API_KEY="re_replace-with-your-api-key"
EMAIL_FROM="FitCrew <onboarding@notifications.yourdomain.com>"
# Optional address for replies from invited users.
EMAIL_REPLY_TO="support@yourdomain.com"
