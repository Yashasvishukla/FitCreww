# The application must use the restricted app role, never the migration role.
DATABASE_URL="postgresql://fitcrew_app:fitcrew_app@127.0.0.1:55432/fitcrew"

# Generate a unique value per environment: `openssl rand -base64 32`.
AUTH_SECRET="replace-with-a-long-random-secret"

# Public origin used to build secure coach and organization invite links.
APP_BASE_URL="http://localhost:3000"

# Transactional email (Resend). Required outside development.
# Verify your sending domain in Resend before using an address on it.
RESEND_API_KEY="re_replace-with-your-api-key"
EMAIL_FROM="FitCrew <onboarding@notifications.yourdomain.com>"
# Optional address for replies from invited users.
EMAIL_REPLY_TO="support@yourdomain.com"
