    "pino": "^9.4.0"
  },
  "devDependencies": {
    "@fitcrew/config": "workspace:*",
    "@types/node": "^22.7.5",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.13.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.3"
  }
