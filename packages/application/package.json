{
  "name": "@fitcrew/application",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./identity-access": {
      "types": "./dist/identity-access/index.d.ts",
      "import": "./dist/identity-access/index.js",
      "default": "./dist/identity-access/index.js"
    },
    "./network": {
      "types": "./dist/network/index.d.ts",
      "import": "./dist/network/index.js",
      "default": "./dist/network/index.js"
    },
    "./client-lifecycle": {
      "types": "./dist/client-lifecycle/index.d.ts",
      "import": "./dist/client-lifecycle/index.js",
      "default": "./dist/client-lifecycle/index.js"
    },
    "./money": {
      "types": "./dist/money/index.d.ts",
      "import": "./dist/money/index.js",
      "default": "./dist/money/index.js"
    },
    "./measurement": {
      "types": "./dist/measurement.d.ts",
      "import": "./dist/measurement.js",
      "default": "./dist/measurement.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "import": "./dist/media/index.js",
      "default": "./dist/media/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "import": "./dist/platform/index.js",
      "default": "./dist/platform/index.js"
    },
    "./notifications": {
      "types": "./dist/notifications/index.d.ts",
      "import": "./dist/notifications/index.js",
      "default": "./dist/notifications/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fitcrew/domain": "workspace:*"
  },
  "devDependencies": {
    "@fitcrew/config": "workspace:*",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.3"
  }
}
